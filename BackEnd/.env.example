# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Official production URL. Used for self-referential links, OAuth callbacks,
# API endpoints, and the allowed browser origin.
APP_URL="https://awalicompany.com"
CORS_ORIGIN="https://awalicompany.com"

# MySQL Database Configuration
# Connects to MySQL Database when configured
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="aw_ali_db"

# Optional one-time password for fallback seed administrators.
# Always use a strong secret and never commit the real value.
SEED_ADMIN_PASSWORD=""
